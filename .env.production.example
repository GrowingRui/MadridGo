# Production settings for infra/docker-compose.prod.yml (docs/DEPLOYMENT.md).
# Copy to .env.production on the server and fill in. Never commit .env.production.

# --- Public addresses ---
# The website is served at https://$MADRIDGO_DOMAIN and the API at https://api.$MADRIDGO_DOMAIN.
# Both DNS names must point at the server before the first start (Let's Encrypt checks them).
MADRIDGO_DOMAIN=madridgo.example
# Let's Encrypt sends certificate expiry notices here.
ACME_EMAIL=you@example.com
# Only needed when the site is not on the standard port (e.g. a local test on 8443):
# MADRIDGO_SITE_ORIGIN=https://localhost:8443
# MADRIDGO_API_ORIGIN=https://api.localhost:8443
# HTTP_PORT=80
# HTTPS_PORT=443

# --- Database ---
POSTGRES_DB=madridgo
POSTGRES_USER=madridgo
# A long random value, e.g. from: openssl rand -base64 32
POSTGRES_PASSWORD=

# --- Data providers (backend only) ---
EMT_CLIENT_ID=
EMT_PASS_KEY=
CRTM_AUTHORIZATION_REF=

# --- OpenTripPlanner memory ---
OTP_HEAP=3g
OTP_BUILD_HEAP=5g

# --- Backups ---
BACKUP_KEEP=7
