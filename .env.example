# Copy to .env and fill in. Never commit .env.

# --- Database (docker compose) ---
POSTGRES_DB=madridgo
POSTGRES_USER=madridgo
POSTGRES_PASSWORD=change-me

# --- API ---
MADRIDGO_ENVIRONMENT=development
# Used when running the API outside Docker (uvicorn on your machine):
MADRIDGO_DATABASE_URL=postgresql://madridgo:change-me@127.0.0.1:5432/madridgo
MADRIDGO_REDIS_URL=redis://127.0.0.1:6379/0
MADRIDGO_CORS_ORIGINS=http://localhost:8081

# --- Data providers (Phase 3; backend only, never in the mobile app) ---
# EMT MobilityLabs credentials from https://mobilitylabs.emtmadrid.es/
EMT_CLIENT_ID=
EMT_PASS_KEY=
# CRTM real-time: keep empty until CRTM grants written authorization.
CRTM_AUTHORIZATION_REF=

# --- Mobile app (apps/mobile/.env) ---
# EXPO_PUBLIC_* values are bundled into the app and are PUBLIC. Never put secrets here.
# Use your computer's LAN IP for a physical phone, 10.0.2.2 for the Android emulator.
EXPO_PUBLIC_API_URL=http://localhost:8000
